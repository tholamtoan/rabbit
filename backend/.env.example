# Gmail account that sends OTP messages
GMAIL_USER=your-gmail@gmail.com

# OAuth 2.0 credentials from Google Cloud Console
GMAIL_CLIENT_ID=your-oauth-client-id
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-oauth-refresh-token

# Neon PostgreSQL connection string (keep the real value only in Render Environment)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: usernames allowed to use admin wallet credit endpoint (comma-separated)
# ADMIN_USERNAMES=your_admin_username

# Comma-separated exact frontend origins, e.g. https://hocungtho.onrender.com
ALLOWED_ORIGINS=https://your-frontend-domain.example
# Exact admin username (case-insensitive); leave empty to disable admin credit API
ADMIN_USERNAMES=
